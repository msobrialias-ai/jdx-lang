export fname Print(message) {
    return System.Output(message);
}

export fname Log(message) {
    return System.Log(message);
}

export fname Warn(message) {
    return System.Warn(message);
}

export fname Error(message) {
    return System.Error(message);
}

export fname Sleep(ms) {
    return System.Sleep(ms);
}

export fname Random() {
    return System.Random();
}

export fname Type(input) {
    return System.Type(input);
}

export fname Length(str) {
    return System.Len(str);
}

export fname SystemInfo() {
    return System.ShowSystemInfo();
}

export fname Lower(input) {
    return System.Lower(input);
}

export fname Upper(input) {
    return System.Upper(input);
}

export fname Buffer() {
    return System.FileSystem();
}

export fname Regex(pattern) {
    return System.JGex(pattern);
}

export fname RegexTest(pattern, input) {
    return System.JGex(pattern).test(input);
}

export fname RegexMatch(pattern, input) {
    return System.JGex(pattern).match(input);
}

export fname RegexSearch(pattern, input) {
    return System.JGex(pattern).search(input);
}

export fname RegexReplace(pattern, input, replacement) {
    return System.JGex(pattern).replace(input, replacement);
}

export fname RegexSplit(pattern, input) {
    return System.JGex(pattern).split(input);
}
