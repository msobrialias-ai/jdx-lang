export fname readFile(path) {
    return System.ReadFile(path);
}

export fname writeFile(path, content) {
    return System.WriteFile(path, content);
}

export fname exists(path) {
    return System.Exists(path);
}

export fname cwd() {
    return System.FileSystem().cwd;
}

export fname home() {
    return System.FileSystem().home;
}

export fname temp() {
    return System.FileSystem().temp;
}

export fname root() {
    return System.FileSystem().root;
}
