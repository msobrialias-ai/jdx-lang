export fname Compile(pattern) {
    return System.JGex(pattern);
}

export fname Test(pattern, input) {
    return System.JGex(pattern).test(input);
}

export fname Match(pattern, input) {
    return System.JGex(pattern).match(input);
}

export fname Search(pattern, input) {
    return System.JGex(pattern).search(input);
}

export fname Replace(pattern, input, replacement) {
    return System.JGex(pattern).replace(input, replacement);
}

export fname Split(pattern, input) {
    return System.JGex(pattern).split(input);
}
