import multiply, { add, double } from "jdx:math";
import * as fs from "jdx:fs";
import { now, now_ms } from "jdx:time";
import { Print, Sleep, Type, Buffer, Log } from "jdx:utils";
import * as regex from "jdx:regex";

Print("2 + 3 = " + add(2, 3));
Print("4 * 5 = " + multiply(4, 5));
Print("double(6) = " + double(6));
Print(now());
Print(now_ms());
Print("Current Working Diretory: " + fs.cwd());
Print("Home: " + fs.home());
